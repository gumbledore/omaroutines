#!/bin/bash
#
# omaroutines - schedule unattended Claude Code runs.
#
# This script is the ONLY writer of tasks.json and runs.json. The sweep timer
# and any overlay shell out to it so locking lives in exactly one place.
# Mirrors ~/.config/omarchy/plugins/gumbledore.reminders/bin/rem: lock() +
# apply() around jq -> mktemp -> mv, single case dispatch below.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaroutines"
TASKS="$STATE_DIR/tasks.json"
RUNS="$STATE_DIR/runs.json"
LOCK="$STATE_DIR/.lock"

CLAUDE_BIN="${OMAROUTINES_CLAUDE_BIN:-claude}"
NOTIFY_BIN="${OMAROUTINES_NOTIFY_BIN:-omarchy-notification-send}"
BACKLOG_TIMEOUT="${OMAROUTINES_BACKLOG_TIMEOUT:-900}"
CLAUDE_HOME="${OMAROUTINES_CLAUDE_HOME:-$HOME/.claude}"
TERMINAL_BIN="${OMAROUTINES_TERMINAL_BIN:-xdg-terminal-exec}"
DEFAULT_AGENT_BIN="${OMAROUTINES_DEFAULT_AGENT_BIN:-omarchy-default-agent}"
HERDR_BIN="${OMAROUTINES_HERDR_BIN:-herdr}"
SYSTEMCTL_BIN="${OMAROUTINES_SYSTEMCTL_BIN:-systemctl}"
HERDR_UNIT="omaroutines-herdr.service"
HERDR_START_WAIT="${OMAROUTINES_HERDR_START_WAIT:-20}" # seconds to wait for the socket
HERDR_QUICK=10                                          # seconds for list/read style calls
HERDR_MUTATE=180                                        # seconds for create/start/close calls
HERDR_AGENT_START_MS=120000                             # herdr-side cap on agent readiness
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omaroutines"
SETTINGS="$CONFIG_DIR/settings.json"
DEFAULTS="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../defaults/settings.json"
RETAIN_RUNS=20
# omarchy agent kinds we accept (omarchy-agent's list minus crush, which has no
# headless path and is not a herdr kind). Headless runs claude only.
AGENT_KINDS="pi omp opencode claude codex grok gemini copilot"
EXECUTIONS="headless herdr"
# Claude Code --permission-mode values we will pass through. Anything else is
# rejected at add/edit and again at run time (settings.json fallback included).
PERM_MODES="default acceptEdits plan dontAsk bypassPermissions auto"
GLYPH="󰃰"

mkdir -p "$STATE_DIR"

# --- store -------------------------------------------------------------------

ensure_store() {
  [[ -f $TASKS ]] || echo '{"version":1,"tasks":[]}' >"$TASKS"
  [[ -f $RUNS ]] || echo '{"version":1,"nextRunId":1,"runs":[]}' >"$RUNS"
}

lock() {
  exec 9>"$LOCK"
  flock 9
}

# Release the lock taken by lock(). Safe to call even if not currently held.
# (No extra redirections here: `exec` without a command makes them permanent,
# so `exec 9>&- 2>/dev/null` would silence stderr for the rest of the script.)
unlock() {
  exec 9>&-
}

# Apply a jq filter to a store file and replace it atomically. Held under the
# lock taken by the caller, so read-modify-write cannot interleave. First arg
# is the target file (tasks.json or runs.json); rest is passed to jq.
apply() {
  local target="$1"
  shift
  local tmp
  tmp=$(mktemp "$STATE_DIR/.$(basename "$target").XXXXXX")
  if jq "$@" "$target" >"$tmp"; then
    mv "$tmp" "$target"
  else
    rm -f "$tmp"
    return 1
  fi
}

# --- time --------------------------------------------------------------------

# Frozen clock for deterministic tests; real clock otherwise.
now() { echo "${OMAROUTINES_NOW:-$(date +%s)}"; }

when_text() { date -d "@$1" +'%a %-d %b %H:%M'; }

# Validate + normalize a systemd calendar expression. Prints the normalized
# form on stdout; on failure prints systemd-analyze's own stderr and returns 1.
normalize_schedule() {
  local expr="$1"
  [[ $expr == manual ]] && {
    echo manual
    return 0
  }
  local out
  if ! out=$(systemd-analyze calendar --iterations=1 "$expr" 2>&1); then
    echo "$out" >&2
    return 1
  fi
  grep '^Normalized form:' <<<"$out" | sed 's/^Normalized form: *//'
}

# Compute next_due epoch for a (already-validated) expression. "manual" -> "".
# Optional --base-time=@<epoch> forwarded to systemd-analyze (ticket 05 needs
# it for "occurrence after next_due"); when OMAROUTINES_NOW is set we always
# pass it so tests are deterministic.
compute_next_due() {
  local expr="$1" base="${2:-}"
  [[ $expr == manual ]] && return 0
  if [[ -z $base && -n ${OMAROUTINES_NOW:-} ]]; then
    base="--base-time=@$(now)"
  fi
  local out elapse
  if [[ -n $base ]]; then
    out=$(systemd-analyze calendar --iterations=1 "$base" "$expr" 2>&1)
  else
    out=$(systemd-analyze calendar --iterations=1 "$expr" 2>&1)
  fi
  elapse=$(grep '^    Next elapse:' <<<"$out" | sed 's/^    Next elapse: *//')
  [[ -z $elapse ]] && return 1
  date -d "$elapse" +%s
}

# --- validation ----------------------------------------------------------------

# Same rule as herdr agent names (^[a-z][a-z0-9_-]{0,31}$), capped at 20 so
# "<name>-<run_id>-<retry>" still fits herdr's 32-char limit.
validate_name() {
  local name="$1"
  [[ $name =~ ^[a-z][a-z0-9_-]{0,19}$ ]] || {
    echo "omaroutines: invalid task name \"$name\" (lowercase letter first, then lowercase letters, digits, _ -; max 20 chars)" >&2
    return 1
  }
}

validate_perm_mode() {
  local mode="$1"
  [[ " $PERM_MODES " == *" $mode "* ]] || {
    echo "omaroutines: invalid permission mode \"$mode\" (allowed: ${PERM_MODES// /, })" >&2
    return 1
  }
}

task_exists() {
  ensure_store
  jq -e --arg n "$1" '.tasks[] | select(.name == $n)' "$TASKS" >/dev/null
}

require_task() {
  task_exists "$1" || {
    echo "omaroutines: no such task \"$1\"" >&2
    return 1
  }
}

# JSON array of session ids that still have a transcript under
# $CLAUDE_HOME/projects — the panel dims Resume from this without a round trip.
available_sessions_json() {
  find "$CLAUDE_HOME/projects" -name '*.jsonl' -printf '%f\n' 2>/dev/null |
    sed 's/\.jsonl$//' | jq -R . | jq -sc .
}

# --- settings ------------------------------------------------------------------

# Merged settings JSON: shipped defaults ⊕ user file, schema_version always the
# shipped one (omagit-config semantics). Missing keys are written back; a file
# that is not JSON is left alone and defaults are used with a warning.
settings_json() {
  local defaults user merged
  defaults=$(jq -c . "$DEFAULTS")
  if [[ -f $SETTINGS ]]; then
    if ! user=$(jq -c . "$SETTINGS" 2>/dev/null); then
      echo "omaroutines: $SETTINGS is not valid JSON, using defaults until it is fixed" >&2
      echo "$defaults"
      return 0
    fi
    merged=$(jq -c -s '.[0].schema_version as $v | .[0] * .[1] | .schema_version = $v' <<<"$defaults"$'\n'"$user")
    [[ $merged == "$user" ]] || write_settings "$merged"
    echo "$merged"
  else
    write_settings "$defaults"
    echo "$defaults"
  fi
}

write_settings() {
  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/.settings.json.XXXXXX")
  jq . <<<"$1" >"$tmp" && mv "$tmp" "$SETTINGS"
}

setting() { settings_json | jq -r --arg k "$1" '.[$k] // empty'; }

validate_agent() {
  [[ " $AGENT_KINDS " == *" $1 "* ]] || {
    echo "omaroutines: unsupported agent \"$1\" (allowed: ${AGENT_KINDS// /, })" >&2
    return 1
  }
}

validate_execution() {
  [[ " $EXECUTIONS " == *" $1 "* ]] || {
    echo "omaroutines: invalid execution \"$1\" (allowed: ${EXECUTIONS// /, })" >&2
    return 1
  }
}

# Resolve the agent kind: task override -> settings -> omarchy default. Prints
# "<kind>|<source>" where source is task|settings|omarchy|none ("" kind = none).
resolve_agent() {
  local task_agent="$1" kind
  if [[ -n $task_agent ]]; then
    echo "$task_agent|task"
    return
  fi
  kind=$(setting agent)
  if [[ -n $kind ]]; then
    echo "$kind|settings"
    return
  fi
  kind=$("$DEFAULT_AGENT_BIN" 2>/dev/null) || kind=""
  if [[ -n $kind ]]; then
    echo "$kind|omarchy"
  else
    echo "|none"
  fi
}

resolve_execution() {
  local task_exec="$1"
  [[ -n $task_exec ]] && { echo "$task_exec"; return; }
  setting execution
}

# The only backend/agent combination we refuse: headless with a non-claude
# kind. Used at add/edit/settings set and again at fire time.
check_combo() {
  local kind="$1" source="$2" execution="$3"
  [[ -z $kind || $execution != headless || $kind == claude ]] && return 0
  echo "omaroutines: headless execution supports claude only (agent \"$kind\" comes from $source); use --execution herdr or --agent claude" >&2
  return 1
}

# JSON array of accepted agent kinds whose executable is on PATH (the panel's
# add form offers these).
installed_agent_kinds_json() {
  local k out=""
  for k in $AGENT_KINDS; do
    command -v "$k" >/dev/null 2>&1 && out+="$k"$'\n'
  done
  printf '%s' "$out" | jq -R . | jq -sc .
}

# --- herdr ---------------------------------------------------------------------

# Session name from settings. hd() mostly runs inside $(...), where a cache
# assignment would be lost, so entry points that make several herdr calls
# set HERDR_SESSION_NAME once up front (see cache_herdr_session).
herdr_session() {
  [[ -n ${HERDR_SESSION_NAME:-} ]] && echo "$HERDR_SESSION_NAME" || setting herdr_session
}
cache_herdr_session() { HERDR_SESSION_NAME=$(setting herdr_session); }

# Run herdr against the configured session. HERDR_SOCKET_PATH/HERDR_ENV are
# scrubbed: inherited from a herdr pane they override HERDR_SESSION and point
# at the foreground server. "default" means the foreground session.
hd() {
  local session
  session=$(herdr_session)
  if [[ $session == default ]]; then
    env -u HERDR_SESSION -u HERDR_SOCKET_PATH -u HERDR_ENV "$HERDR_BIN" "$@"
  else
    env -u HERDR_SOCKET_PATH -u HERDR_ENV HERDR_SESSION="$session" "$HERDR_BIN" "$@"
  fi
}

# Bounded variants (a hung server must not hang `list` or strand a run):
# re-enter this script so `timeout` wraps hd(); the `_herdr` entry execs
# herdr, so the signal reaches it rather than an orphaned child.
HERDR_BIN_WRAP="$(realpath -- "${BASH_SOURCE[0]}")"
hdq() { timeout "$HERDR_QUICK" "$HERDR_BIN_WRAP" _herdr "$@"; }
hdm() { timeout "$HERDR_MUTATE" "$HERDR_BIN_WRAP" _herdr "$@"; }
hd_exec() {
  local session
  session=$(herdr_session)
  if [[ $session == default ]]; then
    exec env -u HERDR_SESSION -u HERDR_SOCKET_PATH -u HERDR_ENV "$HERDR_BIN" "$@"
  else
    exec env -u HERDR_SOCKET_PATH -u HERDR_ENV HERDR_SESSION="$session" "$HERDR_BIN" "$@"
  fi
}

herdr_server_up() {
  hdq status server --json 2>/dev/null | jq -e '.running == true' >/dev/null 2>&1
}

# Start + enable the background unit if the server is down, then wait for the
# socket. The foreground ("default") session is never started by us.
ensure_herdr_server() {
  herdr_server_up && return 0
  if [[ $(herdr_session) == default ]]; then
    echo "omaroutines: herdr server is not running (herdr_session is \"default\": start herdr first)" >&2
    return 1
  fi
  "$SYSTEMCTL_BIN" --user start "$HERDR_UNIT" || {
    echo "omaroutines: could not start $HERDR_UNIT (run install.sh?)" >&2
    return 1
  }
  "$SYSTEMCTL_BIN" --user enable "$HERDR_UNIT" >/dev/null 2>&1 || true
  local deadline=$((SECONDS + HERDR_START_WAIT))
  while ((SECONDS < deadline)); do
    herdr_server_up && return 0
    sleep 0.25
  done
  echo "omaroutines: herdr server did not come up within ${HERDR_START_WAIT}s" >&2
  return 1
}

# JSON array of live pane ids ([] when the server is down / unreachable).
live_panes_json() {
  local out
  out=$(hdq pane list 2>/dev/null) && jq -c '[.result.panes[].pane_id]' <<<"$out" 2>/dev/null && return 0
  echo '[]'
}

# Unattended flags per agent kind, copied from omarchy-agent (keep in sync).
# $2: optional task permission-mode override, honored only by the kinds that
# take --permission-mode (claude, grok); other kinds keep their fixed flag.
unattended_flags() {
  local override="${2:-}"
  case "$1" in
  claude) echo "--permission-mode ${override:-auto}" ;;
  codex) echo "--approve-for-me" ;;
  gemini) echo "--yolo" ;;
  opencode) echo "--auto" ;;
  copilot) echo "--allow-all" ;;
  omp) echo "--auto-approve" ;;
  grok) echo "--permission-mode ${override:-bypassPermissions}" ;;
  *) echo "" ;;
  esac
}

# Kinds whose herdr unattended flags accept a permission-mode override.
perm_override_kind() {
  case "$1" in claude | grok) return 0 ;; *) return 1 ;; esac
}

# Agent lifecycle state by name via `agent list`; "" when absent.
herdr_agent_state() {
  hdq agent list 2>/dev/null | jq -r --arg n "$1" '.result.agents[] | select(.name == $n) | .agent_status' 2>/dev/null | head -1
}

# Map an observed state to "<status>|<reason>" per the spec.
map_agent_state() {
  case "$1" in
  done | idle) echo "success|" ;;
  blocked) echo "failure|blocked" ;;
  working) echo "failure|timeout" ;;
  *) echo "failure|exited" ;;
  esac
}

# Run one task under herdr: workspace by cwd label, new unfocused tab, agent
# start with unattended flags, prompt --wait, settle -> status/reason,
# transcript snapshot. Sets HERDR_RESULT="status|reason", HERDR_PANE,
# HERDR_TAB, HERDR_WS. Everything it prints goes to the run log.
herdr_run() {
  local name="$1" run_id="$2" kind="$3" prompt="$4" cwd="$5" run_dir="$6" timeout_s="$7" perm_mode="${8:-}"
  HERDR_RESULT="failure|exited"
  HERDR_AGENT=""
  HERDR_PANE=""
  HERDR_TAB=""
  HERDR_WS=""

  ensure_herdr_server || return 0

  local label out
  label=$(basename "$cwd")
  HERDR_WS=$(hdq workspace list 2>/dev/null | jq -r --arg l "$label" '[.result.workspaces[] | select(.label == $l)][0].workspace_id // empty') || HERDR_WS=""
  if [[ -z $HERDR_WS ]]; then
    out=$(hdm workspace create --cwd "$cwd" --label "$label" 2>&1) || {
      echo "omaroutines: could not create herdr workspace: $out"
      return 0
    }
    HERDR_WS=$(jq -r '.result.workspace.workspace_id' <<<"$out")
  fi
  out=$(hdm tab create --workspace "$HERDR_WS" --cwd "$run_dir" --no-focus 2>&1) || {
    echo "omaroutines: could not open a herdr tab: $out"
    return 0
  }
  HERDR_PANE=$(jq -r '.result.root_pane.pane_id' <<<"$out")
  HERDR_TAB=$(jq -r '.result.tab.tab_id' <<<"$out")

  local agent="${name}-${run_id}" flags state
  # shellcheck disable=SC2206
  flags=($(unattended_flags "$kind" "$perm_mode"))
  out=$(hdm agent start "$agent" --kind "$kind" --pane "$HERDR_PANE" --timeout "$HERDR_AGENT_START_MS" -- "${flags[@]}" 2>&1) || {
    if [[ $out == *agent_name_taken* ]]; then
      agent="${agent}-$RANDOM"
      out=$(hdm agent start "$agent" --kind "$kind" --pane "$HERDR_PANE" --timeout "$HERDR_AGENT_START_MS" -- "${flags[@]}" 2>&1) || true
    fi
  }
  HERDR_AGENT="$agent"
  state=$(jq -r '.result.agent.agent_status // empty' <<<"$out" 2>/dev/null) || state=""
  if [[ -z $state ]]; then
    # start failed or timed out; the pane, not the exit code, is the truth
    echo "omaroutines: herdr agent start: $out"
    state=$(herdr_agent_state "$agent") || state=""
    if [[ $state != idle && $state != done ]]; then
      HERDR_RESULT=$(map_agent_state "$state")
      snapshot_transcript "$agent"
      return 0
    fi
  fi

  out=$(timeout "$((timeout_s + 60))" "$HERDR_BIN_WRAP" _herdr agent prompt "$agent" "$prompt" --wait --timeout "$((timeout_s * 1000))" 2>&1) || true
  state=$(jq -r '.result.agent.agent_status // empty' <<<"$out" 2>/dev/null) || state=""
  if [[ -z $state ]]; then
    echo "omaroutines: herdr agent prompt: $out"
    state=$(herdr_agent_state "$agent") || state=""
  fi
  HERDR_RESULT=$(map_agent_state "$state")
  snapshot_transcript "$agent"
  return 0
}

# Clean worktree with no commits past the recorded base.
worktree_unchanged() {
  local wt="$1" base="$2"
  [[ -d $wt && -n $base ]] || return 1
  [[ -z $(git -C "$wt" status --porcelain 2>/dev/null) ]] &&
    [[ $(git -C "$wt" rev-list --count "$base"..HEAD 2>/dev/null) -eq 0 ]]
}

# Pane retention for one task, run after a new pane is recorded: panes that
# vanished are reconciled; beyond `herdr_retain` live panes (newest first)
# the settled ones are closed (working/blocked never are). A closed pane's
# unchanged worktree goes with it; the run entry and log stay.
prune_task_panes() {
  local task="$1" retain live agents_json kept=0
  retain=$(setting herdr_retain)
  live=$(live_panes_json)
  agents_json=$(hdq agent list 2>/dev/null | jq -c '.result.agents // []' 2>/dev/null) || agents_json='[]'
  local id pane tab agent wt_path wt_branch base state
  # \x1f-separated: empty fields (no tab_id on a legacy run) must not collapse
  while IFS=$'\x1f' read -r id pane tab agent wt_path wt_branch base; do
    [[ -z $id ]] && continue
    if jq -e --arg p "$pane" 'index($p) != null' <<<"$live" >/dev/null; then
      if ((kept < retain)); then
        kept=$((kept + 1))
        continue
      fi
      state=$(jq -r --arg n "$agent" --arg p "$pane" '[.[] | select(.name == $n or .pane_id == $p)][0].agent_status // empty' <<<"$agents_json")
      [[ $state == working || $state == blocked || -z $tab ]] && continue
      hdm tab close "$tab" </dev/null >/dev/null 2>&1 || {
        echo "omaroutines: could not close pane $pane (run $id); keeping it"
        continue
      }
      echo "omaroutines: closed pane $pane (run $id, retain $retain)"
    fi
    local drop_wt=false
    if [[ $wt_path != null ]] && worktree_unchanged "$wt_path" "$base"; then
      remove_worktree "$(dirname "$(dirname "$wt_path")")" "$wt_path" "$wt_branch"
      drop_wt=true
    fi
    lock
    apply "$RUNS" --argjson id "$id" --argjson drop_wt "$drop_wt" '
      .runs |= map(if .id == $id then .pane_id = null | .tab_id = null
        | (if $drop_wt then .worktree_path = null | .worktree_branch = null else . end) else . end)'
    unlock
  done < <(jq -r --arg t "$task" '
    [.runs[] | select(.task == $t and .pane_id != null)] | sort_by(.id) | reverse | .[]
    | [.id, .pane_id, (.tab_id // ""), (.agent_name // ""), (.worktree_path // "null"),
       (.worktree_branch // ""), (.base_commit // "")] | map(tostring) | join("\u001f")' "$RUNS")
  lock
  retain_runs "$task"
  unlock
}

snapshot_transcript() {
  echo "--- transcript ($1) ---"
  hdq agent read "$1" --source recent --format text 2>/dev/null || echo "(agent no longer present)"
}

# --- commands ------------------------------------------------------------------

# Shared by add/edit: enum/type checks on the new fields, then the combo
# check against what the task would resolve to right now. Warns when a
# permission mode is set on a task that resolves to a herdr agent kind
# whose unattended flags cannot carry it (ignored there).
validate_agent_fields() {
  local agent="$1" execution="$2" herdr_timeout="$3" perm_mode="$4"
  [[ -z $agent ]] || validate_agent "$agent"
  [[ -z $execution ]] || validate_execution "$execution"
  [[ -z $herdr_timeout || $herdr_timeout =~ ^[0-9]+$ ]] || {
    echo "omaroutines: --herdr-timeout must be a whole number of minutes" >&2
    return 1
  }
  local kind source exec_resolved
  IFS='|' read -r kind source < <(resolve_agent "$agent")
  exec_resolved=$(resolve_execution "$execution")
  check_combo "$kind" "$source" "$exec_resolved"
  [[ -n $perm_mode && $exec_resolved == herdr ]] && ! perm_override_kind "$kind" &&
    echo "omaroutines: warning: permission mode is ignored under herdr for agent \"${kind:-unset}\"" >&2
  return 0
}

# worktree=true needs a git repo to run `git worktree add` in.
require_git_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "omaroutines: --cwd \"$1\" is not a git repository (required when --worktree true)" >&2
    return 1
  }
}

cmd_add() {
  local name="${1:-}"
  shift || true
  [[ -z $name ]] && {
    echo "omaroutines: add requires a task name" >&2
    return 1
  }
  validate_name "$name"

  local prompt="" cwd="" schedule="manual" perm_mode="" worktree="true" agent="" execution="" herdr_timeout=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --prompt)
      prompt="$2"
      shift 2
      ;;
    --cwd)
      cwd="$2"
      shift 2
      ;;
    --schedule)
      schedule="$2"
      shift 2
      ;;
    --permission-mode)
      perm_mode="$2"
      shift 2
      ;;
    --worktree)
      worktree="$2"
      shift 2
      ;;
    --agent)
      agent="$2"
      shift 2
      ;;
    --execution)
      execution="$2"
      shift 2
      ;;
    --herdr-timeout)
      herdr_timeout="$2"
      shift 2
      ;;
    *)
      echo "omaroutines: unknown option \"$1\"" >&2
      return 1
      ;;
    esac
  done

  [[ -z $prompt ]] && {
    echo "omaroutines: --prompt is required" >&2
    return 1
  }
  [[ -z $cwd ]] && {
    echo "omaroutines: --cwd is required" >&2
    return 1
  }
  cwd=$(realpath -m "$cwd")
  [[ -d $cwd ]] || {
    echo "omaroutines: --cwd \"$cwd\" is not a directory" >&2
    return 1
  }
  [[ $worktree == true ]] && { require_git_repo "$cwd" || return 1; }

  ensure_store
  if task_exists "$name"; then
    echo "omaroutines: task \"$name\" already exists" >&2
    return 1
  fi

  local normalized next_due=null
  normalized=$(normalize_schedule "$schedule") || {
    echo "omaroutines: invalid schedule \"$schedule\"" >&2
    return 1
  }
  if [[ $normalized != manual ]]; then
    next_due=$(compute_next_due "$normalized") || {
      echo "omaroutines: could not compute next occurrence for \"$schedule\"" >&2
      return 1
    }
  fi
  [[ -z $perm_mode ]] || validate_perm_mode "$perm_mode"
  validate_agent_fields "$agent" "$execution" "$herdr_timeout" "$perm_mode"

  lock
  apply "$TASKS" \
    --arg name "$name" --arg prompt "$prompt" --arg cwd "$cwd" \
    --arg schedule "$normalized" --arg perm "$perm_mode" \
    --argjson worktree "$([[ $worktree == true ]] && echo true || echo false)" \
    --argjson next_due "${next_due:-null}" --argjson now "$(now)" \
    --arg agent "$agent" --arg execution "$execution" --argjson herdr_timeout "${herdr_timeout:-null}" '
    .tasks += [{
      name: $name, prompt: $prompt, cwd: $cwd, schedule: $schedule,
      permission_mode: (if $perm == "" then null else $perm end), worktree: $worktree, enabled: true,
      next_due: $next_due, backlog_since: null, created: $now,
      agent: (if $agent == "" then null else $agent end),
      execution: (if $execution == "" then null else $execution end),
      herdr_timeout: $herdr_timeout
    }]
  '
  echo "added: $name"
}

cmd_edit() {
  local name="${1:-}"
  shift || true
  [[ -z $name ]] && {
    echo "omaroutines: edit requires a task name" >&2
    return 1
  }
  ensure_store
  require_task "$name"

  local set_prompt=0 set_cwd=0 set_schedule=0 set_perm=0 set_worktree=0
  local set_agent=0 set_execution=0 set_timeout=0
  local prompt="" cwd="" schedule="" perm_mode="" worktree="" agent="" execution="" herdr_timeout=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --prompt)
      prompt="$2"
      set_prompt=1
      shift 2
      ;;
    --agent)
      agent="$2"
      set_agent=1
      shift 2
      ;;
    --execution)
      execution="$2"
      set_execution=1
      shift 2
      ;;
    --herdr-timeout)
      herdr_timeout="$2"
      set_timeout=1
      shift 2
      ;;
    --cwd)
      cwd="$2"
      set_cwd=1
      shift 2
      ;;
    --schedule)
      schedule="$2"
      set_schedule=1
      shift 2
      ;;
    --permission-mode)
      perm_mode="$2"
      set_perm=1
      shift 2
      ;;
    --worktree)
      worktree="$2"
      set_worktree=1
      shift 2
      ;;
    *)
      echo "omaroutines: unknown option \"$1\"" >&2
      return 1
      ;;
    esac
  done

  if ((set_cwd)); then
    cwd=$(realpath -m "$cwd")
    [[ -d $cwd ]] || {
      echo "omaroutines: --cwd \"$cwd\" is not a directory" >&2
      return 1
    }
  fi
  if ((set_cwd || set_worktree)); then
    local eff_cwd eff_wt
    eff_cwd=$(jq -r --arg n "$name" '.tasks[] | select(.name == $n) | .cwd' "$TASKS")
    eff_wt=$(jq -r --arg n "$name" '.tasks[] | select(.name == $n) | .worktree' "$TASKS")
    ((set_cwd)) && eff_cwd="$cwd"
    ((set_worktree)) && eff_wt="$worktree"
    [[ $eff_wt == true ]] && { require_git_repo "$eff_cwd" || return 1; }
  fi

  local normalized="" next_due_json="null" have_next_due=0
  if ((set_schedule)); then
    normalized=$(normalize_schedule "$schedule") || {
      echo "omaroutines: invalid schedule \"$schedule\"" >&2
      return 1
    }
    if [[ $normalized != manual ]]; then
      next_due_json=$(compute_next_due "$normalized") || {
        echo "omaroutines: could not compute next occurrence for \"$schedule\"" >&2
        return 1
      }
    fi
    have_next_due=1
  fi

  [[ $perm_mode == none ]] && perm_mode=""
  [[ -z $perm_mode ]] || validate_perm_mode "$perm_mode"
  [[ $agent == none ]] && agent=""
  [[ $execution == none ]] && execution=""
  [[ $herdr_timeout == none ]] && herdr_timeout=""
  # Combo check on the task as it will be after this edit.
  local cur eff_agent eff_exec eff_perm
  cur=$(jq -c --arg n "$name" '.tasks[] | select(.name == $n)' "$TASKS")
  eff_agent=$(jq -r '.agent // empty' <<<"$cur")
  eff_exec=$(jq -r '.execution // empty' <<<"$cur")
  eff_perm=$(jq -r '.permission_mode // empty' <<<"$cur")
  ((set_agent)) && eff_agent="$agent"
  ((set_execution)) && eff_exec="$execution"
  ((set_perm)) && eff_perm="$perm_mode"
  validate_agent_fields "$eff_agent" "$eff_exec" "$herdr_timeout" "$eff_perm"

  lock
  apply "$TASKS" \
    --arg name "$name" \
    --argjson set_agent "$set_agent" --arg agent "$agent" \
    --argjson set_execution "$set_execution" --arg execution "$execution" \
    --argjson set_timeout "$set_timeout" --argjson herdr_timeout "${herdr_timeout:-null}" \
    --argjson set_prompt "$set_prompt" --arg prompt "$prompt" \
    --argjson set_cwd "$set_cwd" --arg cwd "$cwd" \
    --argjson set_schedule "$set_schedule" --arg schedule "$normalized" \
    --argjson have_next_due "$have_next_due" --argjson next_due "$next_due_json" \
    --argjson set_perm "$set_perm" --arg perm "$perm_mode" \
    --argjson set_worktree "$set_worktree" \
    --argjson worktree "$([[ $worktree == true ]] && echo true || echo false)" '
    .tasks |= map(if .name == $name then
        (if $set_prompt == 1 then .prompt = $prompt else . end)
      | (if $set_cwd == 1 then .cwd = $cwd else . end)
      | (if $set_schedule == 1 then .schedule = $schedule | .next_due = $next_due | .backlog_since = null else . end)
      | (if $set_perm == 1 then .permission_mode = (if $perm == "" then null else $perm end) else . end)
      | (if $set_worktree == 1 then .worktree = $worktree else . end)
      | (if $set_agent == 1 then .agent = (if $agent == "" then null else $agent end) else . end)
      | (if $set_execution == 1 then .execution = (if $execution == "" then null else $execution end) else . end)
      | (if $set_timeout == 1 then .herdr_timeout = $herdr_timeout else . end)
      else . end)
  '
  echo "edited: $name"
}

cmd_list() {
  ensure_store
  if [[ ${1:-} == --json ]]; then
    # jq's strftime is UTC-only; build a local-time text map in bash so
    # --json and the human table agree. tasks.json is read once: the widget
    # polls on file change, i.e. while the CLI may be rewriting next_due.
    local tasks_json text_map="{}" d
    tasks_json=$(cat "$TASKS")
    for d in $(jq -r '[.tasks[].next_due // empty] | unique | .[]' <<<"$tasks_json"); do
      text_map=$(jq -c --argjson d "$d" --arg t "$(when_text "$d")" '. + {($d|tostring): $t}' <<<"$text_map")
    done
    # Bar-widget summary (spec: .scratch/omaroutines-bar-widget/spec.md).
    # last_run = newest run per task; disabled tasks still count as
    # failed/running but never as backlog/next.
    # Agent resolution is done once here (settings + omarchy default) and
    # applied per task in jq; the omarchy default is a subprocess.
    local s_agent s_exec o_agent s_session kinds
    s_agent=$(setting agent)
    s_exec=$(setting execution)
    s_session=$(setting herdr_session)
    o_agent=$("$DEFAULT_AGENT_BIN" 2>/dev/null) || o_agent=""
    kinds=$(installed_agent_kinds_json)
    jq -c --argjson map "$text_map" --slurpfile runs "$RUNS" --argjson avail "$(available_sessions_json)" \
      --argjson panes "$(live_panes_json)" --argjson kinds "$kinds" \
      --arg s_agent "$s_agent" --arg s_exec "$s_exec" --arg o_agent "$o_agent" \
      --arg s_session "$s_session" --arg s_path "$SETTINGS" '
      ($runs[0].runs | group_by(.task) | map({key: .[0].task, value: (max_by(.id) | {id, status, trigger, start, end, backend: (.backend // "headless"), reason: (.reason // null), pane_id: (.pane_id // null), session_available: (.session_id as $s | $avail | index($s) != null), pane_available: (.pane_id as $p | $p != null and ($panes | index($p)) != null)})}) | from_entries) as $last
      | ($runs[0].runs | map(select(.worktree_path != null)) | group_by(.task) | map({key: .[0].task, value: length}) | from_entries) as $wts
      | (.tasks | map(. + {
          agent: (.agent // (if $s_agent != "" then $s_agent elif $o_agent != "" then $o_agent else null end)),
          agent_source: (if .agent != null then "task" elif $s_agent != "" then "settings" elif $o_agent != "" then "omarchy" else "none" end),
          execution: (.execution // $s_exec),
          next_due_text: (if .next_due == null then "-" else $map[(.next_due|tostring)] end),
          last_run: ($last[.name] // null),
          worktrees: ($wts[.name] // 0)
        })) as $tasks
      | ($tasks | map(select(.enabled and .next_due != null)) | min_by(.next_due)) as $n
      | {
          count: ($tasks | length),
          tasks: $tasks,
          enabled: ($tasks | map(select(.enabled)) | length),
          failed: ($tasks | map(select(.last_run.status == "failure")) | length),
          running: ($tasks | map(select(.last_run.status == "running")) | length),
          backlog: ($tasks | map(select(.enabled and .backlog_since != null)) | length),
          next: (if $n == null then null else {task: $n.name, next_due: $n.next_due, next_due_text: $n.next_due_text} end)
        }
      | .settings = {
          execution: $s_exec,
          agent: (if $s_agent != "" then $s_agent elif $o_agent != "" then $o_agent else null end),
          agent_source: (if $s_agent != "" then "settings" elif $o_agent != "" then "omarchy" else "none" end),
          herdr_session: $s_session, path: $s_path
        }
      | .agent_kinds = $kinds
      | .badge = .failed + .backlog
      | .active = (.badge > 0)
      | .tooltip = (
          if .enabled == 0 then "No enabled tasks"
          else (if .next == null then "Next: none" else "Next: \(.next.task) \(.next.next_due_text)" end)
            + (if .failed > 0 then " · \(.failed) failed" else "" end)
            + (if .running > 0 then " · \(.running) running" else "" end)
            + (if .backlog > 0 then " · \(.backlog) backlog" else "" end)
          end)
    ' <<<"$tasks_json"
    return
  fi

  local any=0
  while IFS=$'\t' read -r name schedule enabled next_due; do
    any=1
    local due_text="-"
    [[ $next_due != null ]] && due_text=$(when_text "$next_due")
    local state="on"
    [[ $enabled == false ]] && state="off (disabled)"
    printf '  %-20s %-24s %-8s %s\n' "$name" "$schedule" "$state" "$due_text"
  done < <(jq -r '.tasks[] | [.name, .schedule, .enabled, (.next_due // "null")] | @tsv' "$TASKS")

  ((any)) || echo "  no scheduled tasks"
}

cmd_rm() {
  local name="${1:-}"
  [[ -z $name ]] && {
    echo "omaroutines: rm requires a task name" >&2
    return 1
  }
  ensure_store
  require_task "$name"
  lock
  apply "$TASKS" --arg name "$name" '.tasks |= map(select(.name != $name))'
  echo "removed: $name"
}

cmd_set_enabled() {
  local name="${1:-}" value="$2"
  [[ -z $name ]] && {
    echo "omaroutines: task name required" >&2
    return 1
  }
  ensure_store
  require_task "$name"
  lock
  apply "$TASKS" --arg name "$name" --argjson value "$value" '
    .tasks |= map(if .name == $name then .enabled = $value else . end)
  '
}

cmd_enable() {
  cmd_set_enabled "${1:-}" true
  echo "enabled: ${1:-}"
}

cmd_disable() {
  cmd_set_enabled "${1:-}" false
  echo "disabled: ${1:-}"
}

# --- execution (ticket 03) ----------------------------------------------------

# Finalize a run-log entry (under lock) by merging a JSON patch of fields and
# setting `end`, then prune that task's runs to the newest RETAIN_RUNS; runs
# that still hold a worktree or a live herdr pane are exempt so `prune` /
# `attach` can find them later. Log files follow runs.json: any logs/<id>.out
# with no matching run is removed.
finalize_run() {
  local run_id="$1" task="$2" patch="$3"
  local end
  end=$(now)
  lock
  apply "$RUNS" --argjson id "$run_id" --argjson end "$end" --argjson patch "$patch" '
    .runs |= map(if .id == $id then . + $patch + {end: $end} else . end)'
  retain_runs "$task"
  unlock
}

# Trim a task's runs to the newest RETAIN_RUNS (kept-worktree / live-pane
# runs are extra) and drop log files of runs no longer listed. Caller holds
# the lock.
retain_runs() {
  local task="$1"
  apply "$RUNS" --arg task "$task" --argjson retain "$RETAIN_RUNS" '
    .runs |= (
        (map(select(.task != $task))) as $others
      | (map(select(.task == $task and (.worktree_path != null or .pane_id != null)))) as $kept
      | (map(select(.task == $task and .worktree_path == null and .pane_id == null)) | sort_by(.id) | .[-$retain:]) as $mine
      | ($others + $kept + $mine) | sort_by(.id)
    )
  '
  local live f
  live=$(jq -r '.runs[].id' "$RUNS")
  for f in "$STATE_DIR/logs"/*.out; do
    [[ -f $f ]] || continue
    grep -qx "$(basename "$f" .out)" <<<"$live" || rm -f "$f"
  done
}

# Run a task end to end: worktree, claude -p invocation, worktree cleanup,
# run-log entry. Shared by trigger / sweep / backlog run (trigger arg is
# manual | scheduled | backlog-catchup). Prints "<run-id> <status>" on stdout
# and returns 0 on success, 1 on failure -- callers that care parse that line;
# Claude's own output never reaches the CLI's stdout.
run_task() {
  local name="$1" trigger="$2"
  local task_json prompt cwd perm_override worktree_enabled
  task_json=$(jq -c --arg n "$name" '.tasks[] | select(.name == $n)' "$TASKS")
  prompt=$(jq -r '.prompt' <<<"$task_json")
  cwd=$(jq -r '.cwd' <<<"$task_json")
  perm_override=$(jq -r '.permission_mode // empty' <<<"$task_json")
  worktree_enabled=$(jq -r '.worktree' <<<"$task_json")

  # Resolve backend + agent kind now: the omarchy default may have changed
  # since the task was added. Done before the run entry exists so a bad
  # config still gets a logged, failed run below.
  local kind source execution
  IFS='|' read -r kind source < <(resolve_agent "$(jq -r '.agent // empty' <<<"$task_json")")
  execution=$(resolve_execution "$(jq -r '.execution // empty' <<<"$task_json")")

  mkdir -p -m 700 "$STATE_DIR/logs"

  local sid start run_id
  sid=$(uuidgen)
  [[ $execution == herdr ]] && sid=""
  start=$(now)
  lock
  run_id=$(jq -r '.nextRunId' "$RUNS")
  apply "$RUNS" \
    --argjson id "$run_id" --arg task "$name" --arg trig "$trigger" \
    --argjson start "$start" --arg sid "$sid" --arg backend "$execution" '
    .nextRunId = ($id + 1)
    | .runs += [{
        id: $id, task: $task, trigger: $trig, start: $start, end: null,
        status: "running", exit_code: null, session_id: (if $sid == "" then null else $sid end),
        permission_mode: null, worktree_path: null, worktree_branch: null, cwd: null,
        backend: $backend, reason: null, pane_id: null, tab_id: null, workspace_id: null, agent_name: null
      }]
  '
  unlock

  local log_file="$STATE_DIR/logs/${run_id}.out"
  (umask 077 && : >"$log_file")

  # A run that never launches an agent: log the message, record the reason.
  fail_config() {
    echo "omaroutines: $1" | tee -a "$log_file" >&2
    finalize_run "$run_id" "$name" "$(jq -nc --arg c "$cwd" '{exit_code: 1, status: "failure", reason: "invalid_config", cwd: $c}')"
    echo "$run_id failure"
    return 1
  }

  if [[ -z $kind ]]; then
    fail_config "no default agent set for \"$name\" (run: omarchy default agent <name>)"
    return 1
  fi
  if ! validate_agent "$kind" 2>>"$log_file" || ! check_combo "$kind" "$source" "$execution" 2>>"$log_file"; then
    fail_config "task \"$name\" has no valid backend for agent \"$kind\" under $execution (see run $run_id log)"
    return 1
  fi

  local mode="$perm_override"
  if [[ -z $mode ]]; then
    mode=$(jq -r '.permissions.defaultMode // empty' "$CLAUDE_HOME/settings.json" 2>/dev/null) || true
  fi
  [[ -z $mode ]] && mode="default"
  if [[ $execution == headless ]] && ! validate_perm_mode "$mode" 2>>"$log_file"; then
    fail_config "invalid permission mode \"$mode\" for \"$name\""
    return 1
  fi

  local run_dir="$cwd" wt_path="" wt_branch="" base_commit=""
  if [[ $worktree_enabled == true ]]; then
    local stamp
    stamp=$(date -d "@$start" +%Y%m%d-%H%M%S)
    wt_branch="omaroutines/${name}-${stamp}-${run_id}"
    wt_path="$cwd/.worktrees/${name}-${stamp}-${run_id}"
    mkdir -p "$cwd/.worktrees"
    # rev-parse fails on a repo with no commits; treat it like a failed worktree add
    if ! base_commit=$(git -C "$cwd" rev-parse HEAD 2>>"$log_file") ||
      ! git -C "$cwd" worktree add -b "$wt_branch" "$wt_path" >>"$log_file" 2>&1; then
      echo "omaroutines: failed to create worktree for \"$name\"" >>"$log_file"
      finalize_run "$run_id" "$name" "$(jq -nc --arg c "$cwd" '{exit_code: 1, status: "failure", cwd: $c}')"
      echo "omaroutines: failed to create worktree for \"$name\"" >&2
      echo "$run_id failure"
      return 1
    fi
    run_dir="$wt_path"
  fi

  local exit_code status reason="" pane="" tab="" ws="" agent_name=""
  if [[ $execution == herdr ]]; then
    local timeout_s herdr_perm=""
    timeout_s=$(jq -r '.herdr_timeout // empty' <<<"$task_json")
    [[ -n $timeout_s ]] || timeout_s=$(setting herdr_timeout_minutes)
    timeout_s=$((timeout_s * 60))
    [[ -n ${OMAROUTINES_HERDR_TIMEOUT:-} ]] && timeout_s="$OMAROUTINES_HERDR_TIMEOUT"
    # Only an explicit task override reaches herdr (no defaultMode fallback),
    # and only for kinds whose unattended flags can carry it.
    if [[ -n $perm_override ]] && perm_override_kind "$kind"; then
      if ! validate_perm_mode "$perm_override" 2>>"$log_file"; then
        fail_config "invalid permission mode \"$perm_override\" for \"$name\""
        return 1
      fi
      herdr_perm="$perm_override"
    fi
    cache_herdr_session
    # errexit off: a failed herdr query must end in finalize_run, never in a
    # run stranded as "running" (the sweep's `run` path has no `||` guard).
    set +e
    herdr_run "$name" "$run_id" "$kind" "$prompt" "$cwd" "$run_dir" "$timeout_s" "$herdr_perm" >>"$log_file" 2>&1
    set -e
    status=${HERDR_RESULT%%|*}
    reason=${HERDR_RESULT#*|}
    pane="$HERDR_PANE"
    tab="$HERDR_TAB"
    ws="$HERDR_WS"
    agent_name="$HERDR_AGENT"
    exit_code=0
    [[ $status == success ]] || exit_code=1
    mode="$herdr_perm"
    [[ -n $pane ]] || grep -h '^omaroutines:' "$log_file" >&2 || true
  else
    set +e
    (cd "$run_dir" && "$CLAUDE_BIN" -p "$prompt" --session-id "$sid" --permission-mode "$mode" --output-format json) >"$log_file" 2>&1
    exit_code=$?
    set -e
    status="success"
    ((exit_code == 0)) || status="failure"
  fi

  # Unchanged worktrees are removed now, except while a herdr pane still
  # lives in them (attach must find the files); pane pruning removes those.
  if [[ $worktree_enabled == true ]]; then
    local unchanged=0
    if [[ -z $(git -C "$wt_path" status --porcelain) ]] &&
      [[ $(git -C "$wt_path" rev-list --count "$base_commit"..HEAD) -eq 0 ]]; then
      unchanged=1
    fi
    if ((unchanged)) && [[ -z $pane ]]; then
      remove_worktree "$cwd" "$wt_path" "$wt_branch"
      wt_path=""
      wt_branch=""
    fi
  fi

  finalize_run "$run_id" "$name" "$(jq -nc --argjson ec "$exit_code" --arg st "$status" --arg sid "$sid" \
    --arg mode "$mode" --arg wp "$wt_path" --arg wb "$wt_branch" --arg rd "$run_dir" \
    --arg reason "$reason" --arg pane "$pane" --arg tab "$tab" --arg ws "$ws" --arg agent "$agent_name" \
    --arg base "$base_commit" '
    def nn: if . == "" then null else . end;
    {exit_code: $ec, status: $st, session_id: ($sid | nn), permission_mode: ($mode | nn),
     worktree_path: ($wp | nn), worktree_branch: ($wb | nn), cwd: $rd,
     reason: ($reason | nn), pane_id: ($pane | nn), tab_id: ($tab | nn), workspace_id: ($ws | nn),
     agent_name: ($agent | nn), base_commit: (if $wp == "" then null else $base end)}')"
  # Pane retention runs once this run's pane is on record, so exactly
  # herdr_retain panes (newest first) survive per task.
  if [[ -n $pane ]]; then
    set +e
    prune_task_panes "$name" >>"$log_file" 2>&1
    set -e
  fi
  echo "$run_id $status"
  [[ $status == success ]]
}

remove_worktree() {
  git -C "$1" worktree remove --force "$2" >/dev/null 2>&1 || true
  git -C "$1" branch -D "$3" >/dev/null 2>&1 || true
}

cmd_trigger() {
  local name="${1:-}"
  [[ -z $name ]] && {
    echo "omaroutines: trigger requires a task name" >&2
    return 1
  }
  ensure_store
  require_task "$name"

  local out rc=0
  out=$(run_task "$name" manual) || rc=$?
  local run_id status
  read -r run_id status <<<"$out"
  echo "run $run_id: $status ($(run_handle "$run_id"))"
  return "$rc"
}

# "session <id>" for headless runs, "pane <id>" for herdr runs.
run_handle() {
  jq -r --argjson id "$1" '.runs[] | select(.id == $id)
    | if .backend == "herdr" then "pane \(.pane_id // "none")" else "session \(.session_id)" end' "$RUNS"
}

# Recompute + persist next_due for a task "from now" (under lock). Used after
# every fire/backlog resolution so a task never re-fires on the next sweep.
reschedule_from_now() {
  local name="$1" schedule="$2" next_due
  next_due=$(compute_next_due "$schedule") || next_due=null
  lock
  apply "$TASKS" --arg name "$name" --argjson next_due "${next_due:-null}" '
    .tasks |= map(if .name == $name then .next_due = $next_due else . end)
  '
  unlock
}

cmd_sweep() {
  ensure_store
  local sweep_now
  sweep_now=$(now)

  local due
  due=$(jq -r --argjson now "$sweep_now" '
    .tasks[] | select(.enabled == true and .schedule != "manual" and .next_due != null and .next_due <= $now)
    | [.name, .schedule, .next_due, (.backlog_since // "null")] | @tsv
  ' "$TASKS")

  [[ -z $due ]] && return 0

  local pids=()
  local name schedule next_due backlog_since
  while IFS=$'\t' read -r name schedule next_due backlog_since; do
    if [[ $backlog_since != null ]]; then
      if ((sweep_now - backlog_since >= BACKLOG_TIMEOUT)); then
        lock
        apply "$TASKS" --arg name "$name" '.tasks |= map(if .name == $name then .backlog_since = null else . end)'
        unlock
        reschedule_from_now "$name" "$schedule"
        echo "$name: backlog skipped (no response)"
      fi
      # else: pending, not yet timed out -- leave alone, no re-notify.
      continue
    fi

    local second_occurrence
    second_occurrence=$(compute_next_due "$schedule" "--base-time=@$next_due") || second_occurrence=""
    if [[ -n $second_occurrence ]] && ((second_occurrence <= sweep_now)); then
      lock
      apply "$TASKS" --arg name "$name" --argjson now "$sweep_now" \
        '.tasks |= map(if .name == $name then .backlog_since = $now else . end)'
      unlock
      "$NOTIFY_BIN" -g "$GLYPH" "Omaroutines: missed runs of $name" \
        "Machine was away across several scheduled runs. Click to run the backlog once, or ignore to skip (auto-skip in $((BACKLOG_TIMEOUT / 60)) min)." \
        --exec omaroutines backlog run "$name" >/dev/null 2>&1 || true
      echo "$name: backlog pending (notified)"
    else
      reschedule_from_now "$name" "$schedule"
      launch_run "$name" scheduled
      echo "$name: fired"
    fi
  done <<<"$due"

  if [[ ${OMAROUTINES_SWEEP_WAIT:-} == 1 && ${#pids[@]} -gt 0 ]]; then
    wait "${pids[@]}" 2>/dev/null || true
  fi
}

# Detach a run from the sweep. Under the systemd oneshot service a plain `&`
# child is killed the moment sweep exits (KillMode=control-group), so there
# each run becomes its own transient unit; elsewhere (tests, a shell) `&` is fine.
launch_run() {
  local name="$1" trigger="$2"
  if [[ -n ${INVOCATION_ID:-} && ${OMAROUTINES_SWEEP_WAIT:-} != 1 ]] && command -v systemd-run >/dev/null; then
    systemd-run --user --quiet --collect --unit "omaroutines-run-$name-$(now)-$$" \
      --setenv=PATH="$PATH" "$(realpath "$0")" run "$name" "$trigger" || {
      echo "omaroutines: systemd-run failed for \"$name\"" >&2
    }
  else
    run_task "$name" "$trigger" >/dev/null 2>&1 &
    pids+=("$!")
  fi
}

cmd_backlog() {
  local verb="${1:-}" name="${2:-}"
  [[ $verb == run || $verb == skip ]] || {
    echo "omaroutines: backlog requires \"run\" or \"skip\" <name>" >&2
    return 1
  }
  [[ -z $name ]] && {
    echo "omaroutines: backlog $verb requires a task name" >&2
    return 1
  }
  ensure_store
  require_task "$name"

  local schedule
  schedule=$(jq -r --arg n "$name" '.tasks[] | select(.name == $n) | .schedule' "$TASKS")

  lock
  apply "$TASKS" --arg name "$name" '.tasks |= map(if .name == $name then .backlog_since = null else . end)'
  unlock
  reschedule_from_now "$name" "$schedule"

  if [[ $verb == skip ]]; then
    echo "$name: backlog skipped"
    return 0
  fi

  local out rc=0
  out=$(run_task "$name" backlog-catchup) || rc=$?
  local run_id status
  read -r run_id status <<<"$out"
  echo "run $run_id: $status ($(run_handle "$run_id"))"
  return "$rc"
}

cmd_log() {
  local name="${1:-}"
  shift || true
  [[ -z $name ]] && {
    echo "omaroutines: log requires a task name" >&2
    return 1
  }
  ensure_store
  require_task "$name"

  if [[ ${1:-} == --json ]]; then
    # log_path is null once the captured output file is gone.
    local logs_json
    logs_json=$(find "$STATE_DIR/logs" -name '*.out' -printf '%f\n' 2>/dev/null | sed 's/\.out$//' | jq -R . | jq -sc .)
    jq -c --arg n "$name" --arg logs "$STATE_DIR/logs" \
      --argjson avail "$(available_sessions_json)" --argjson logs_present "$logs_json" \
      --argjson panes "$(live_panes_json)" '
      [.runs[] | select(.task == $n)
        | .backend = (.backend // "headless") | .reason = (.reason // null) | .pane_id = (.pane_id // null)
        | .session_available = (.session_id as $s | $avail | index($s) != null)
        | .pane_available = (.pane_id as $p | $p != null and ($panes | index($p)) != null)
        | .log_path = ((.id | tostring) as $i | if ($logs_present | index($i)) != null then "\($logs)/\($i).out" else null end)]
      | sort_by(.id) | reverse' "$RUNS"
    return
  fi

  local any=0
  while IFS=$'\t' read -r id start end status trig; do
    any=1
    local start_text end_text
    start_text=$(when_text "$start")
    end_text="-"
    [[ $end != null ]] && end_text=$(when_text "$end")
    printf '  #%-4s %-9s %-20s %-20s %s\n' "$id" "$status" "$start_text" "$end_text" "$trig"
  done < <(jq -r --arg n "$name" '
    [.runs[] | select(.task == $n)] | sort_by(.id) | reverse
    | .[] | [.id, .start, (.end // "null"), .status, .trigger] | @tsv
  ' "$RUNS")

  ((any)) || echo "  no runs yet"
}

cmd_resume() {
  local run_id="${1:-}" terminal=0
  [[ ${2:-} == --terminal ]] && terminal=1
  [[ -z $run_id ]] && {
    echo "omaroutines: resume requires a run id" >&2
    return 1
  }
  ensure_store

  local run
  run=$(jq -c --argjson id "$run_id" '.runs[] | select(.id == $id)' "$RUNS" 2>/dev/null) || run=""
  [[ -z $run ]] && {
    echo "omaroutines: no such run \"$run_id\"" >&2
    return 1
  }

  local sid task_name rcwd
  sid=$(jq -r '.session_id' <<<"$run")
  task_name=$(jq -r '.task' <<<"$run")
  rcwd=$(jq -r '.cwd' <<<"$run")

  [[ $(jq -r '.backend // "headless"' <<<"$run") == herdr ]] && {
    echo "omaroutines: run $run_id is a herdr run; use: omaroutines attach $run_id" >&2
    return 1
  }
  if ! compgen -G "$CLAUDE_HOME/projects/*/${sid}.jsonl" >/dev/null; then
    echo "omaroutines: session no longer available (run $run_id)" >&2
    return 1
  fi

  [[ -d $rcwd ]] || rcwd=$(jq -r --arg n "$task_name" '.tasks[] | select(.name == $n) | .cwd' "$TASKS")
  # --terminal (panel): checks done, hand the actual resume to a detached
  # terminal so the caller returns immediately.
  if ((terminal)); then
    setsid -f "$TERMINAL_BIN" "$(realpath "$0")" resume "$run_id" >/dev/null 2>&1
    return 0
  fi
  cd "$rcwd"
  exec "$CLAUDE_BIN" --resume "$sid"
}

# attach <run-id> [--terminal]: focus the run's agent in the background
# session, then attach a terminal to that session (the herdr counterpart of
# resume). --terminal hands the attach to a detached terminal like resume.
cmd_attach() {
  local run_id="${1:-}" terminal=0
  [[ ${2:-} == --terminal ]] && terminal=1
  [[ -z $run_id ]] && {
    echo "omaroutines: attach requires a run id" >&2
    return 1
  }
  ensure_store
  cache_herdr_session
  local run
  run=$(jq -c --argjson id "$run_id" '.runs[] | select(.id == $id)' "$RUNS" 2>/dev/null) || run=""
  [[ -z $run ]] && {
    echo "omaroutines: no such run \"$run_id\"" >&2
    return 1
  }
  [[ $(jq -r '.backend // "headless"' <<<"$run") == herdr ]] || {
    echo "omaroutines: run $run_id is a headless run; use: omaroutines resume $run_id" >&2
    return 1
  }
  local pane agent
  pane=$(jq -r '.pane_id // empty' <<<"$run")
  agent=$(jq -r '.agent_name // empty' <<<"$run")
  if [[ -z $pane ]] || ! live_panes_json | jq -e --arg p "$pane" 'index($p) != null' >/dev/null; then
    echo "omaroutines: pane not available for run $run_id (pruned, closed, or herdr server down)" >&2
    return 1
  fi
  if ((terminal)); then
    setsid -f "$TERMINAL_BIN" "$(realpath "$0")" attach "$run_id" >/dev/null 2>&1
    return 0
  fi
  [[ -z $agent ]] || hdq agent focus "$agent" >/dev/null 2>&1 || true
  local session
  session=$(herdr_session)
  if [[ $session == default ]]; then
    hd_exec
  fi
  hd_exec session attach "$session"
}

# --- worktree pruning ----------------------------------------------------------

# The repo's default branch: origin/HEAD if known, else main, else master.
default_branch() {
  local repo="$1" b
  b=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && {
    echo "$b"
    return 0
  }
  for b in main master; do
    git -C "$repo" rev-parse --verify -q "$b" >/dev/null 2>&1 && {
      echo "$b"
      return 0
    }
  done
  return 1
}

# Merged = ancestor of the default branch, or every commit has a
# patch-equivalent there (squash/rebase merges). Local only; never fetches.
is_merged() {
  local repo="$1" branch="$2" def
  def=$(default_branch "$repo") || return 1
  git -C "$repo" rev-parse --verify -q "$branch" >/dev/null 2>&1 || return 1
  git -C "$repo" merge-base --is-ancestor "$branch" "$def" 2>/dev/null && return 0
  ! git -C "$repo" cherry "$def" "$branch" 2>/dev/null | grep -q '^+'
}

clear_worktree_record() {
  lock
  apply "$RUNS" --argjson id "$1" '
    .runs |= map(if .id == $id then .worktree_path = null | .worktree_branch = null else . end)
  '
  unlock
}

# Remove every kept worktree whose branch is merged (see is_merged); clear the
# record of any worktree already deleted by hand. Unmerged or dirty worktrees
# are left alone. The panel calls this on open. Prints "pruned: <path>" per removal.
cmd_prune() {
  ensure_store
  local id wt_path wt_branch repo
  while IFS=$'\t' read -r id wt_path wt_branch; do
    [[ -z $id ]] && continue
    repo=$(dirname "$(dirname "$wt_path")")
    if [[ ! -d $wt_path ]]; then
      git -C "$repo" worktree prune >/dev/null 2>&1 || true
      [[ $wt_branch != null ]] && git -C "$repo" branch -D "$wt_branch" >/dev/null 2>&1 || true
      clear_worktree_record "$id"
      continue
    fi
    [[ $wt_branch == null ]] && continue
    is_merged "$repo" "$wt_branch" || continue
    # no --force: a worktree with uncommitted changes is refused and kept
    git -C "$repo" worktree remove "$wt_path" >/dev/null 2>&1 || continue
    git -C "$repo" branch -D "$wt_branch" >/dev/null 2>&1 || true
    clear_worktree_record "$id"
    echo "pruned: $wt_path"
  done < <(jq -r '.runs[] | select(.worktree_path != null and .pane_id == null) | [.id, .worktree_path, (.worktree_branch // "null")] | @tsv' "$RUNS")
}

# settings | settings get <key> | settings set <key> <value>
cmd_settings() {
  local verb="${1:-}" key="${2:-}" value="${3:-}"
  case "$verb" in
  "")
    settings_json | jq .
    ;;
  get)
    [[ -n $key ]] || { echo "omaroutines: settings get requires a key" >&2; return 1; }
    settings_json | jq -e --arg k "$key" 'has($k)' >/dev/null || {
      echo "omaroutines: unknown setting \"$key\"" >&2
      return 1
    }
    settings_json | jq -r --arg k "$key" '.[$k]'
    ;;
  set)
    [[ -n $key && $# -ge 3 ]] || { echo "omaroutines: settings set requires <key> <value>" >&2; return 1; }
    local json
    case "$key" in
    execution)
      validate_execution "$value"
      json=$(jq -n --arg v "$value" '$v')
      ;;
    agent)
      if [[ $value == null || $value == none ]]; then
        json=null
      else
        validate_agent "$value"
        json=$(jq -n --arg v "$value" '$v')
      fi
      ;;
    herdr_session)
      [[ $value =~ ^[A-Za-z0-9._-]+$ ]] || { echo "omaroutines: invalid session name \"$value\"" >&2; return 1; }
      json=$(jq -n --arg v "$value" '$v')
      ;;
    herdr_retain | herdr_timeout_minutes)
      [[ $value =~ ^[1-9][0-9]*$ ]] || { echo "omaroutines: $key must be a whole number >= 1" >&2; return 1; }
      json=$value
      ;;
    *)
      echo "omaroutines: unknown or read-only setting \"$key\"" >&2
      return 1
      ;;
    esac
    # Combo check at the settings layer: what would a task with no overrides get?
    local merged kind exec_resolved
    merged=$(settings_json | jq -c --arg k "$key" --argjson v "$json" '.[$k] = $v')
    kind=$(jq -r '.agent // empty' <<<"$merged")
    exec_resolved=$(jq -r '.execution' <<<"$merged")
    check_combo "$kind" settings "$exec_resolved"
    lock
    write_settings "$merged"
    unlock
    echo "set: $key"
    ;;
  *)
    echo "omaroutines: settings takes no verb, \"get <key>\" or \"set <key> <value>\"" >&2
    return 1
    ;;
  esac
}

cmd_show_overlay() { omarchy-shell shell summon gumbledore.omaroutines "{}" >/dev/null 2>&1 || true; }

usage() {
  cat <<'EOF'
Usage:
  omaroutines add <name> --prompt <text> --cwd <dir> [--schedule <expr>|manual]
                          [--permission-mode <mode>] [--worktree true|false]
                          [--agent <kind>] [--execution headless|herdr] [--herdr-timeout <min>]
  omaroutines edit <name> [--prompt ...] [--cwd ...] [--schedule ...]
                          [--permission-mode <mode>|none] [--worktree true|false]
                          [--agent <kind>|none] [--execution ...|none] [--herdr-timeout <min>|none]
  omaroutines settings [get <key> | set <key> <value>]
                                       show / read / write settings.json
  omaroutines list [--json]           list tasks
  omaroutines rm <name>               remove a task
  omaroutines enable <name>           re-enable a disabled task
  omaroutines disable <name>          disable without deleting
  omaroutines trigger <name>          run now
  omaroutines sweep                   fire due tasks (called by the timer)
  omaroutines backlog run|skip <name> resolve a pending backlog notification
  omaroutines log <name> [--json]     show a task's run history
  omaroutines resume <run-id> [--terminal]
                                       resume a past headless run's Claude session
                                       (--terminal: in a new terminal window)
  omaroutines attach <run-id> [--terminal]
                                       attach to a herdr run's pane
  omaroutines prune                   remove kept worktrees whose branch is merged
  omaroutines show-overlay            open the task panel

Default --schedule is "manual" (never fires on its own). Schedule expressions
are systemd calendar specs, validated via `systemd-analyze calendar`.
Agent kind resolves task --agent -> settings agent -> `omarchy default agent`;
execution resolves task --execution -> settings execution (default headless,
claude only).
EOF
}

case ${1:-} in
add)
  shift
  cmd_add "$@"
  ;;
edit)
  shift
  cmd_edit "$@"
  ;;
list | ls)
  shift || true
  cmd_list "${1:-}"
  ;;
rm | remove)
  shift
  cmd_rm "$@"
  ;;
enable)
  shift
  cmd_enable "$@"
  ;;
disable)
  shift
  cmd_disable "$@"
  ;;
trigger)
  shift
  cmd_trigger "$@"
  ;;
run)
  # internal: one run as a transient systemd unit (see launch_run)
  shift
  run_task "$1" "$2" >/dev/null
  ;;
_herdr)
  # internal: herdr re-entered through `timeout` (see hdq/hdm)
  shift
  hd_exec "$@"
  ;;
sweep)
  cmd_sweep
  ;;
backlog)
  shift
  cmd_backlog "$@"
  ;;
log)
  shift
  cmd_log "$@"
  ;;
resume)
  shift
  cmd_resume "$@"
  ;;
attach)
  shift
  cmd_attach "$@"
  ;;
prune)
  cmd_prune
  ;;
settings)
  shift
  cmd_settings "$@"
  ;;
show-overlay)
  cmd_show_overlay
  ;;
-h | --help | help)
  usage
  ;;
*)
  usage
  exit 1
  ;;
esac
