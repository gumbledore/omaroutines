#!/bin/bash
#
# omaroutines - schedule unattended Claude Code runs.
#
# This script is the ONLY writer of tasks.json and runs.json. The sweep timer
# and any overlay shell out to it so locking lives in exactly one place.
# Mirrors ~/.config/omarchy/plugins/gumbledore.reminders/bin/rem: lock() +
# apply() around jq -> mktemp -> mv, single case dispatch below.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaroutines"
TASKS="$STATE_DIR/tasks.json"
RUNS="$STATE_DIR/runs.json"
LOCK="$STATE_DIR/.lock"
HERDR_LAUNCH_LOCK="$STATE_DIR/.herdr-launch.lock"
HERDR_LAUNCH_STAMP="$STATE_DIR/.herdr-launch-stamp"

CLAUDE_BIN="${OMAROUTINES_CLAUDE_BIN:-claude}"
NOTIFY_BIN="${OMAROUTINES_NOTIFY_BIN:-omarchy-notification-send}"
BACKLOG_TIMEOUT="${OMAROUTINES_BACKLOG_TIMEOUT:-900}"
MISS_GRACE="${OMAROUTINES_MISS_GRACE:-120}"     # seconds late before a fire counts as missed
RESUME_DELAY="${OMAROUTINES_RESUME_DELAY:-60}" # settle time before a missed run starts
CLAUDE_HOME="${OMAROUTINES_CLAUDE_HOME:-$HOME/.claude}"
TERMINAL_BIN="${OMAROUTINES_TERMINAL_BIN:-xdg-terminal-exec}"
DEFAULT_AGENT_BIN="${OMAROUTINES_DEFAULT_AGENT_BIN:-omarchy-default-agent}"
HERDR_BIN="${OMAROUTINES_HERDR_BIN:-herdr}"
SYSTEMCTL_BIN="${OMAROUTINES_SYSTEMCTL_BIN:-systemctl}"
HERDR_UNIT="omaroutines-herdr.service"
HERDR_START_WAIT="${OMAROUTINES_HERDR_START_WAIT:-20}" # seconds to wait for the socket
HERDR_QUICK=10                                          # seconds for list/read style calls
HERDR_MUTATE=180                                        # seconds for create/start/close calls
HERDR_AGENT_START_MS=120000                             # herdr-side cap on agent readiness
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omaroutines"
SETTINGS="$CONFIG_DIR/settings.json"
DEFAULTS="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../defaults/settings.json"
HERDR_BIN_WRAP="$(realpath -- "${BASH_SOURCE[0]}")" # re-entry target for hdq/hdm
RETAIN_RUNS=20
# omarchy agent kinds we accept (omarchy-agent's list minus crush, which has no
# headless path and is not a herdr kind). Headless runs claude only.
AGENT_KINDS="pi omp opencode claude codex grok gemini copilot"
EXECUTIONS="headless herdr"
# Claude Code --permission-mode values we will pass through. Anything else is
# rejected at add/edit and again at run time (settings.json fallback included).
PERM_MODES="default acceptEdits plan dontAsk bypassPermissions auto"
# Claude model aliases the panel offers; `--model` accepts any token claude
# would (alias or full id), see validate_model.
MODEL_CHOICES="sonnet opus fable haiku"
GLYPH="󰃰"

mkdir -p "$STATE_DIR"

LIB="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/../lib"
source "$LIB/core.sh"
source "$LIB/herdr.sh"
source "$LIB/commands.sh"
source "$LIB/run.sh"
source "$LIB/prune.sh"

usage() {
  cat <<'EOF'
Usage:
  omaroutines add <name> --prompt <text> --cwd <dir> [--schedule <expr>|manual]
                          [--permission-mode <mode>] [--worktree true|false]
                          [--agent <kind>] [--execution headless|herdr] [--herdr-timeout <min>]
                          [--settings <json|file>] [--model <alias|id>]
  omaroutines edit <name> [--prompt ...] [--cwd ...] [--schedule ...]
                          [--permission-mode <mode>|none] [--worktree true|false]
                          [--agent <kind>|none] [--execution ...|none] [--herdr-timeout <min>|none]
                          [--settings <json|file>|none] [--model <alias|id>|none]
  omaroutines settings [get <key> | set <key> <value>]
                                       show / read / write settings.json
  omaroutines list [--json]           list tasks
  omaroutines rm <name>               remove a task
  omaroutines enable <name>           re-enable a disabled task
  omaroutines disable <name>          disable without deleting
  omaroutines trigger <name>          run now
  omaroutines sweep                   fire due tasks (called by the timer)
  omaroutines backlog run|skip <name> resolve a pending backlog notification
  omaroutines dismiss <name>          clear a task's failed / needs-input last run
  omaroutines dismiss --missed        acknowledge every task's missed latest run
  omaroutines log <name> [--json]     show a task's run history
  omaroutines resume <run-id> [--terminal]
                                       resume a past headless run's Claude session
                                       (--terminal: in a new terminal window)
  omaroutines attach <run-id> [--terminal]
                                       attach to a herdr run's pane
  omaroutines prune                   remove kept worktrees whose branch is merged
  omaroutines show-overlay            open the task panel

Default --schedule is "manual" (never fires on its own). Schedule expressions
are systemd calendar specs, validated via `systemd-analyze calendar`.
Agent kind resolves task --agent -> settings agent -> `omarchy default agent`;
execution resolves task --execution -> settings execution (default headless,
claude only). Model resolves task --model -> settings model -> the agent's own
default; passed as --model to claude, pi, codex, gemini (settings default:
claude only).
EOF
}

case ${1:-} in
add)
  shift
  cmd_add "$@"
  ;;
edit)
  shift
  cmd_edit "$@"
  ;;
list | ls)
  shift || true
  cmd_list "${1:-}"
  ;;
rm | remove)
  shift
  cmd_rm "$@"
  ;;
enable)
  shift
  cmd_enable "$@"
  ;;
disable)
  shift
  cmd_disable "$@"
  ;;
trigger)
  shift
  cmd_trigger "$@"
  ;;
run)
  # internal: one run as a transient systemd unit (see launch_run)
  shift
  run_task "$1" "$2" >/dev/null
  ;;
_herdr)
  # internal: herdr re-entered through `timeout` (see hdq/hdm)
  shift
  hd_exec "$@"
  ;;
sweep)
  cmd_sweep
  ;;
backlog)
  shift
  cmd_backlog "$@"
  ;;
dismiss)
  shift
  cmd_dismiss "$@"
  ;;
log)
  shift
  cmd_log "$@"
  ;;
resume)
  shift
  cmd_resume "$@"
  ;;
attach)
  shift
  cmd_attach "$@"
  ;;
prune)
  cmd_prune
  ;;
settings)
  shift
  cmd_settings "$@"
  ;;
show-overlay)
  cmd_show_overlay
  ;;
-h | --help | help)
  usage
  ;;
*)
  usage
  exit 1
  ;;
esac
